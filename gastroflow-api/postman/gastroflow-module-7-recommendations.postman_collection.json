{
  "info": {
    "_postman_id": "dd7dfdad-f815-465a-a071-654d18721ff0",
    "name": "GastroFlow - Module 7 Recommendations",
    "description": "Local Postman collection for testing GastroFlow Module 7: Recommendations. It seeds the restaurant, ingredients, inventory, and recipes, runs recipe-sale stock consumption, creates waste signals, generates rule-based recommendations, filters them, fetches one by ID, and applies/dismisses recommendations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
