      "key": "ingredientId",
      "value": "ingredient_rest_demo_001_lettuce"
    },
    {
      "key": "inventoryBatchId",
      "value": "batch_rest_demo_001_lettuce_demo_001"
    },
    {
      "key": "recipeId",
      "value": "recipe_rest_demo_001_chicken_rice_bowl"
    },
    {
      "key": "recommendationId",
      "value": "replace_after_generate"
