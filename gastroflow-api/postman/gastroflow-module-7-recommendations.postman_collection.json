    {
      "name": "05 Run Restaurant Activity - Steak Plate x3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Steak Plate activity consumed stock', function () {",
              "  pm.expect(pm.response.code).to.eql(201);",
              "  pm.expect(json.recipeName).to.eql('Steak Plate');",
              "  pm.expect(json.quantitySold).to.eql(3);",
              "  pm.expect(json.unitMenuPrice).to.eql(18.99);",
              "  pm.expect(json.totalSalesRevenue).to.eql(56.97);",
              "  pm.expect(json.inventoryCostConsumed).to.eql(14.37);",
              "  pm.expect(json.estimatedGrossProfit).to.eql(42.6);",
              "  pm.expect(json.estimatedGrossMarginPercentage).to.eql(74.78);",
              "  pm.expect(json.movements.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipeId\": \"recipe_rest_demo_001_steak_plate\",\n  \"quantitySold\": 3,\n  \"notes\": \"Module 7 setup: restaurant activity before recommendation generation.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/stock-consumptions/recipe-sale",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "restaurants",
            "{{restaurantId}}",
            "stock-consumptions",
            "recipe-sale"
          ]
        },
        "description": "Runs recipe-sale stock consumption before generating recommendations. This makes the recommendation engine evaluate inventory after real operational activity."
      }
    },
    {
      "name": "06 Run Restaurant Activity - Chicken Rice Bowl x4",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Chicken Rice Bowl activity consumed stock', function () {",
              "  pm.expect(pm.response.code).to.eql(201);",
              "  pm.expect(json.recipeName).to.eql('Chicken Rice Bowl');",
              "  pm.expect(json.quantitySold).to.eql(4);",
              "  pm.expect(json.unitMenuPrice).to.eql(13.49);",
              "  pm.expect(json.totalSalesRevenue).to.eql(53.96);",
              "  pm.expect(json.inventoryCostConsumed).to.eql(11.4);",
              "  pm.expect(json.estimatedGrossProfit).to.eql(42.56);",
              "  pm.expect(json.estimatedGrossMarginPercentage).to.eql(78.87);",
              "  pm.expect(json.movements.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipeId\": \"{{recipeId}}\",\n  \"quantitySold\": 4,\n  \"notes\": \"Module 7 setup: second restaurant activity signal before recommendation generation.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/stock-consumptions/recipe-sale",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "restaurants",
            "{{restaurantId}}",
            "stock-consumptions",
            "recipe-sale"
          ]
        },
        "description": "Consumes chicken, rice, tomato, lettuce, and onion before recommendations are generated."
      }
    },
    {
      "name": "07 Create Waste Signal - Spoiled Lettuce 100g",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inventoryBatchId\": \"{{inventoryBatchId}}\",\n  \"quantityWasted\": 100,\n  \"reason\": \"SPOILED\",\n  \"notes\": \"Module 7 setup: first lettuce waste signal for recommendation engine.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/waste-events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "restaurants",
            "{{restaurantId}}",
            "waste-events"
          ]
        },
        "description": "Creates the first small lettuce waste event. Two waste events for the same ingredient trigger the WASTE_PATTERN_DETECTED recommendation rule."
      }
    },
    {
      "name": "08 Create Waste Signal - Expired Lettuce 100g",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inventoryBatchId\": \"{{inventoryBatchId}}\",\n  \"quantityWasted\": 100,\n  \"reason\": \"EXPIRED\",\n  \"notes\": \"Module 7 setup: second lettuce waste signal for recommendation engine.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/waste-events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "restaurants",
            "{{restaurantId}}",
            "waste-events"
          ]
        }
      }
    },
    {
      "name": "09 Generate Recommendations",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const recommendations = json.recommendations || [];",
              "if (recommendations.length > 0) {",
              "  pm.collectionVariables.set('recommendationId', recommendations[0].id);",
              "  const dismissTarget = recommendations.find((recommendation) => recommendation.type === 'WASTE_PATTERN_DETECTED') || recommendations[1] || recommendations[0];",
              "  pm.collectionVariables.set('dismissRecommendationId', dismissTarget.id);",
              "}",
              "pm.test('Recommendations generated', function () {",
              "  pm.expect(pm.response.code).to.eql(201);",
              "  pm.expect(json.restaurantId).to.eql(pm.collectionVariables.get('restaurantId'));",
              "  pm.expect(json.generatedCount).to.be.above(0);",
              "});",
              "pm.test('At least one open recommendation is returned', function () {",
              "  pm.expect(recommendations.some((recommendation) => recommendation.status === 'OPEN')).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Manual Module 7 recommendation generation test.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recommendations/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "restaurants",
            "{{restaurantId}}",
            "recommendations",
            "generate"
          ]
        },
        "description": "Reads inventory batches, active recipes, and waste events, then creates rule-based recommendations."
      }
    },
