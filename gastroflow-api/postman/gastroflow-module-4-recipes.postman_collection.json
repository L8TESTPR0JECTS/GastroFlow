    {
      "name": "08 Get Seeded Cheeseburger Recipe",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recipes/{{cheeseburgerRecipeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["restaurants", "{{restaurantId}}", "recipes", "{{cheeseburgerRecipeId}}"]
        }
      }
    },
    {
      "name": "09 Create Manual Steak Rice Bowl Recipe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Steak Rice Bowl\",\n  \"description\": \"A steak rice bowl with tomato, onion, and cheese.\",\n  \"category\": \"BOWL\",\n  \"menuPrice\": 14.49,\n  \"ingredients\": [\n    {\n      \"ingredientId\": \"{{steakIngredientId}}\",\n      \"quantity\": 180\n    },\n    {\n      \"ingredientId\": \"{{riceIngredientId}}\",\n      \"quantity\": 250\n    },\n    {\n      \"ingredientId\": \"{{tomatoIngredientId}}\",\n      \"quantity\": 50\n    },\n    {\n      \"ingredientId\": \"{{onionIngredientId}}\",\n      \"quantity\": 25\n    },\n    {\n      \"ingredientId\": \"{{cheeseIngredientId}}\",\n      \"quantity\": 35\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recipes",
          "host": ["{{baseUrl}}"],
          "path": ["restaurants", "{{restaurantId}}", "recipes"]
        },
        "description": "Expected ID: recipe_rest_demo_001_steak_rice_bowl. The API calculates ingredient cost, gross profit, and margin."
      }
    },
    {
      "name": "10 Duplicate Create Should Return 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Steak Rice Bowl\",\n  \"description\": \"A duplicate steak rice bowl request to verify nameKey conflict handling.\",\n  \"category\": \"BOWL\",\n  \"menuPrice\": 14.49,\n  \"ingredients\": [\n    {\n      \"ingredientId\": \"{{steakIngredientId}}\",\n      \"quantity\": 180\n    },\n    {\n      \"ingredientId\": \"{{riceIngredientId}}\",\n      \"quantity\": 250\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recipes",
          "host": ["{{baseUrl}}"],
          "path": ["restaurants", "{{restaurantId}}", "recipes"]
        },
        "description": "Expected result after request 09 has run: 409 Conflict."
      }
    },
    {
      "name": "11 Update Steak Rice Bowl Price and Ingredients",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"menuPrice\": 15.99,\n  \"description\": \"A higher-margin steak rice bowl with tomato, onion, cheese, and lettuce.\",\n  \"ingredients\": [\n    {\n      \"ingredientId\": \"{{steakIngredientId}}\",\n      \"quantity\": 180\n    },\n    {\n      \"ingredientId\": \"{{riceIngredientId}}\",\n      \"quantity\": 250\n    },\n    {\n      \"ingredientId\": \"{{tomatoIngredientId}}\",\n      \"quantity\": 50\n    },\n    {\n      \"ingredientId\": \"{{lettuceIngredientId}}\",\n      \"quantity\": 30\n    },\n    {\n      \"ingredientId\": \"{{onionIngredientId}}\",\n      \"quantity\": 25\n    },\n    {\n      \"ingredientId\": \"{{cheeseIngredientId}}\",\n      \"quantity\": 35\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recipes/{{steakRiceBowlRecipeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["restaurants", "{{restaurantId}}", "recipes", "{{steakRiceBowlRecipeId}}"]
        },
        "description": "Expected: profitability fields are recalculated."
      }
    },
    {
      "name": "12 Soft Delete Steak Rice Bowl Recipe",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recipes/{{steakRiceBowlRecipeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["restaurants", "{{restaurantId}}", "recipes", "{{steakRiceBowlRecipeId}}"]
        },
        "description": "Expected result: isActive false and status INACTIVE."
      }
    },
    {
      "name": "13 List Inactive Recipes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recipes?isActive=false",
          "host": ["{{baseUrl}}"],
          "path": ["restaurants", "{{restaurantId}}", "recipes"],
          "query": [
            {
              "key": "isActive",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "name": "14 Invalid Duplicate Ingredient Lines Should Return 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Invalid Double Steak Recipe\",\n  \"description\": \"This should fail because steak appears twice.\",\n  \"category\": \"PLATE\",\n  \"menuPrice\": 19.99,\n  \"ingredients\": [\n    {\n      \"ingredientId\": \"{{steakIngredientId}}\",\n      \"quantity\": 100\n    },\n    {\n      \"ingredientId\": \"{{steakIngredientId}}\",\n      \"quantity\": 120\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/recipes",
          "host": ["{{baseUrl}}"],
          "path": ["restaurants", "{{restaurantId}}", "recipes"]
        },
        "description": "Expected result: 400 Bad Request because duplicate ingredient lines are rejected."
      }
    }
